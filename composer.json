{
    "name": "concept7/laravel-nbo",
    "description": "Integrate NieuwbouwOffice API into a Laravel app",
    "keywords": [
        "Concept7",
        "laravel",
        "nieuwbouwoffice"
    ],
    "homepage": "https://github.com/concept7/laravel-nbo",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Henk Hazelaar",
            "email": "janhenk@concept7.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "concept7/nbo-php-sdk": "^0.0.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0.0||^10.0.0||^11.1.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Concept7\\LaravelNieuwbouwOffice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Concept7\\LaravelNieuwbouwOffice\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Concept7\\LaravelNieuwbouwOffice\\NieuwbouwOfficeServiceProvider"
            ],
            "aliases": {
                "NieuwbouwOffice": "Concept7\\LaravelNieuwbouwOffice\\Facades\\NieuwbouwOffice"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
